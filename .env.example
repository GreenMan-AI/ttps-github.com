# Cloudinary — bilžu un mūzikas glabāšanai (bezmaksas konts pietiek sākumam)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Admin konta pieejas dati — OBLIGĀTI NOMAINI uz kaut ko savu!
ADMIN_USER=admin
ADMIN_PASS=main-parole-123

# Nav obligāti — ja iestati, admin panelis (/admin) un tā API būs pieejami
# TIKAI no šīm IP adresēm; visiem citiem tas izskatīsies kā lapa, kas
# vispār nepastāv (404). Ar komatu atdalīts saraksts, piem.:
#   ADMIN_ALLOWED_IPS=85.12.34.56,91.20.10.1
# Savu pašreizējo IP vari uzzināt, ejot uz whatismyip.com.
# Ja atstāj tukšu — nekāda ierobežojuma nav (admin pieejams no jebkurienes,
# aizsargāts tikai ar paroli + 2FA, tāpat kā līdz šim).
ADMIN_ALLOWED_IPS=

# Ports (Render to iestata automātiski, lokāli var atstāt 3000)
