# Nokopē šo failu par ".env" un ievieto savas vērtības.
# Uz Render.com tās jāievieto zem "Environment" cilnes (nevis šajā failā).

# MongoDB savienojuma virkne (piem. no MongoDB Atlas)
MONGODB_URI=mongodb+srv://lietotajs:parole@cluster.mongodb.net/soundpulse

# Cloudinary — bilžu un mūzikas glabāšanai (bezmaksas konts pietiek sākumam)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Admin konta pieejas dati — OBLIGĀTI NOMAINI uz kaut ko savu!
ADMIN_USER=admin
ADMIN_PASS=main-parole-123

# Nav obligāti — ja iestati, admin panelis (/admin) un tā API būs pieejami
# TIKAI no šīm IP adresēm; visiem citiem tas izskatīsies kā lapa, kas
# vispār nepastāv (404). Ar komatu atdalīts saraksts, piem.:
#   ADMIN_ALLOWED_IPS=85.12.34.56,91.20.10.1
# Savu pašreizējo IP vari uzzināt, ejot uz whatismyip.com.
# Ja atstāj tukšu — nekāda ierobežojuma nav (admin pieejams no jebkurienes,
# aizsargāts tikai ar paroli + 2FA, tāpat kā līdz šim).
ADMIN_ALLOWED_IPS=

# Ports (Render to iestata automātiski, lokāli var atstāt 3000)
PORT=3000

# SVARĪGI drošībai: iestati uz "production", kad lapa darbojas ar īstu domēnu
# un HTTPS (piem. Render). Tas liek admin sesijas cookie sūtīt tikai pa HTTPS.
# Lokālai izstrādei (http://localhost) atstāj tukšu vai "development".
NODE_ENV=production

# Nav obligāti — vajadzīgs TIKAI, ja kāds cits domēns (ne pati lapa) drīkst
# sūtīt pieprasījumus ar admin sesiju (piem. atsevišķa admin lietotne).
# Parastai lapas lietošanai var atstāt tukšu. Vairāki domēni — atdalīt ar komatu.
ALLOWED_ORIGINS=

# IETEICAMS, lai tulkošana (LV↔EN admin panelī un čatā) būtu daudz precīzāka!
# Bez šīs atslēgas lapa izmanto bezmaksas, bet neuzticamu Google triku.
# Ar DeepL atslēgu tulkošana kļūst ievērojami labāka. Bezmaksas — 500 000
# rakstzīmes/mēnesī, nav vajadzīga kredītkarte:
#   1. Ej uz https://www.deepl.com/pro-api (izvēlies "DeepL API Free")
#   2. Reģistrējies, apstiprini e-pastu
#   3. Konta iestatījumos atrodi savu API atslēgu (beidzas ar ":fx")
#   4. Ielīmē to šeit:
DEEPL_API_KEY=
