# Copy this file to .env and fill in real values before running the server.
# Never commit the real .env file.

# Long random string used to sign admin session tokens.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Port the server listens on. Railway/Render set this automatically — leave
# it as-is for local dev.
PORT=3000

# Set to "production" when deployed (enables secure cookies over HTTPS).
NODE_ENV=development

# Optional: restrict CORS to your real domain once deployed, e.g.
# ALLOWED_ORIGIN=https://your-site.up.railway.app
ALLOWED_ORIGIN=
