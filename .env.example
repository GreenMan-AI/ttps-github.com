# ═══════════════════════════════════════════════════
#  PULSS — vides mainīgie
#  1. Nokopē šo failu kā ".env" lokālai izstrādei
#  2. Render.com: Dashboard → Environment → pievieno tos pašus
# ═══════════════════════════════════════════════════

# MongoDB Atlas — OBLIGĀTS. Izmanto TO PAŠU datubāzi/URI, kur jau ir tavas
# dziesmas (kolekcija "tracks"), citādi tās atkal neparādīsies.
MONGODB_URI=mongodb+srv://<lietotajvards>:<parole>@<cluster>.mongodb.net/<db-nosaukums>?retryWrites=true&w=majority

# Cloudinary — OBLIGĀTS, jo tur glabājas audio faili (cloudinary.com → Dashboard)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Admin pieejas dati
ADMIN_USER=admin
ADMIN_PASS=izveido-savu-drosu-paroli-seit

PORT=3000

# Neobligāti — ja gribi kvalitatīvāku automātisko tulkošanu paziņojumiem,
# vari vēlāk pieslēgt DeepL/Google Translate API. Bez šī izmantosim
# bezmaksas MyMemory tulkošanas servisu (ierobežota kvalitāte, bet strādā uzreiz).
