# Nokopē šo failu par ".env" un ieraksti savus īstos datus
MONGODB_URI=mongodb+srv://<lietotajvards>:<parole>@<cluster-nosaukums>.mongodb.net/pulss?retryWrites=true&w=majority
PORT=3000

# Parole admin panelim — izvēlies kaut ko drošu, nevis "admin123"
ADMIN_PASS=izveido-savu-drosu-paroli-seit

# Piezīme: kods pieņem arī MONGO_URI / ADMIN_PASSWORD kā alternatīvus nosaukumus,
# ja tā jau ir iestatīts kaut kur citur — abi varianti strādā.
